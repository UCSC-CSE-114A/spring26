eval test_updatepair :
    UPDATEPAIR STARTINGPAIR 
    =~> \b -> b ZERO ONE -- PAIR ZERO ONE

eval test_updatepair_2 :
    UPDATEPAIR (PAIR THREE FOUR)
    =~> \b -> b FOUR FIVE -- PAIR FOUR FIVE

eval test_decr : 
    DECR THREE
    =~> TWO